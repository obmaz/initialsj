; Open this file in Godot 4.7.2.
config_version=5

[application]
config/name="Initial SJ — Coast Rush"
config/version="0.1"
config/icon="res://assets/ui/coast-rush-icon.svg"
boot_splash/bg_color=Color(0.02745, 0.06667, 0.11765, 1)
boot_splash/image="res://assets/ui/drive-loading.png"
boot_splash/show_image=true
boot_splash/fullsize=true
boot_splash/use_filter=true
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="3D arcade racing with a branching five-stage Tour and five three-lap circuits. Four fictional cars, distinct nitro systems, mobile and gamepad controls."

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=4

[rendering]

textures/vram_compression/import_s3tc_bptc=true
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.42, 0.69, 0.86, 1)
textures/default_filters/use_nearest_mipmap_filter=false

[physics]
common/physics_interpolation=true

[editor_plugins]
enabled=PackedStringArray("res://addons/app_version/plugin.cfg")
